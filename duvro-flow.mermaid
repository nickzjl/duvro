flowchart TD
    A["welcome<br/><i>start a new chapter</i>"] --> B["import<br/><i>pick your favorites · 20–200</i>"]
    A -.-> A2["demo<br/><i>bundled sample photos</i>"]
    A2 --> E

    B --> C["vibe selection<br/><i>photo count input · 3 pack cards</i>"]
    C -->|tap a pack card| D["vibe preview sheet<br/><i>~5 samples in that look</i>"]
    D -->|cancel| C
    D -->|"use this vibe"| E["curation progress<br/><i>on-device scoring</i>"]

    E --> F["curation showcase<br/><i>our favorites · reveal</i>"]
    F -->|auto-advance, no input| G

    G["three-way edit<br/><i>photo n of N · 3 variants</i>"]
    G -->|advanced| G1["adjust sheet<br/><i>intensity · brightness · contrast · crop</i>"]
    G1 --> G
    G -->|skip this photo| H
    G -->|"save and continue"| H{"more photos?"}
    H -->|yes| G
    H -->|no| I

    I["final review<br/><i>the final touches</i>"]
    I -->|reorder / remove / adjust| I
    I -->|add or swap a runner-up| G
    I -->|continue| J["caption<br/><i>1 suggestion · editable · regenerate</i>"]

    J -->|"copy and finish"| K["ready when you are<br/><i>album saved · caption copied · 3-step guide</i>"]
    K -->|"open instagram"| L(["Instagram<br/><i>user finishes the post</i>"])
    K -.->|start over| A

    classDef noDecision fill:#EEE9DF,stroke:#A04021,stroke-width:2px
    classDef terminal fill:#171614,color:#F7F4EE,stroke:#171614
    class E,F noDecision
    class L terminal
